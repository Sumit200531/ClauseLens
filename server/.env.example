PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/clauselens
CLIENT_URL=http://localhost:5173

# AI provider: gemini | openai | local
#   local  = no API key needed. Hash embeddings + extractive answers, so the
#            whole app runs offline. Great for demos; answers are simpler.
#   gemini = Google AI Studio key (has a free tier): https://aistudio.google.com/apikey
#   openai = OpenAI key
AI_PROVIDER=local

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# Set to true only if you use MongoDB Atlas and created the vector index
# described in the README. Otherwise vectors are compared in memory.
ATLAS_VECTOR_SEARCH=false
